# Клон myanon для локальной сборки: в образе он клонируется по
# закреплённому коммиту, в репозитории чужой код не хранится.
myanon/

# Результаты прогонов: каталог монтируется в контейнер как /work.
out/

# Служебное
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
graphify-out/
.DS_Store
.gitattributes

# Отчёты замеров пишутся в корень при прогоне; сохранённые копии,
# на которые ссылается README, лежат в measurements/ и версионируются.
/scan_report.json
/detect_report.json
